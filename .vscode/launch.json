{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat Service",
      "type": "debugpy",
      "request": "launch",
      "module": "src.agent_platform",
      "python": "uv",
      "pythonArgs": ["run", "python"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on http://127\\.0\\.0\\.1:8000",
        "uriFormat": "http://127.0.0.1:8000/",
        "killOnServerStop": true
      }
    },
    {
      "name": "ETL Pipeline",
      "type": "debugpy",
      "request": "launch",
      "module": "src.etl",
      "args": [
        "--chain",
        "${input:chain}",
        "--extract",
        "${input:extract}",
        "${input:source}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SuperCompare Crawler (Milk)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.product_classification.supercompare",
      "args": [
        "--category",
        "dairy-and-eggs",
        "--subcategory",
        "milk",
        "--log-level",
        "DEBUG"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SuperCompare Crawler (Full)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.product_classification.supercompare",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "chain",
      "type": "pickString",
      "description": "Which supermarket chain?",
      "options": [
        {
          "label": "Shufersal",
          "value": "shufersal"
        },
        {
          "label": "Rami Levy",
          "value": "rami_levy"
        },
        {
          "label": "Victory",
          "value": "victory"
        }
      ],
      "default": "shufersal"
    },
    {
      "id": "extract",
      "type": "pickString",
      "description": "Which dataset?",
      "options": [
        {
          "label": "PriceFull",
          "value": "prices_full"
        },
        {
          "label": "Stores",
          "value": "stores"
        },
        {
          "label": "PromoFull",
          "value": "promo_full"
        }
      ],
      "default": "prices_full"
    },
    {
      "id": "source",
      "type": "pickString",
      "description": "Where should files come from?",
      "options": [
        {
          "label": "Download (dev caps)",
          "value": "--download"
        },
        {
          "label": "Full download",
          "value": "--full"
        },
        {
          "label": "Use local files",
          "value": "--no-download"
        }
      ],
      "default": "--download"
    }
  ]
}
