DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_grocery
DB_USER=postgres
DB_PASSWORD=your_password_here

REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=postgres
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=

# Agent platform chat service.
# AGENT_MODEL is a pydantic-ai model string: "<provider>:<model>".
# Use "openai-chat:gpt-4o-mini" for the fast, cheap, reliable Chat Completions model.
AGENT_MODEL=openai-chat:gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Model sampling settings.
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2048
AGENT_TOP_P=1.0

# Per-run cost ceiling, enforced by pydantic-ai UsageLimits.
AGENT_REQUEST_LIMIT=12
AGENT_TOOL_CALLS_LIMIT=20
AGENT_TOTAL_TOKENS_LIMIT=120000

# Per-conversation token bucket for incoming chat requests.
AGENT_RATE_LIMIT_REQUESTS_PER_MINUTE=20
AGENT_RATE_LIMIT_BURST=5

# How much conversation history is allowed onto the wire per model request.
AGENT_HISTORY_MAX_MESSAGES=40
AGENT_HISTORY_MAX_CHARS=60000

# Read-only guard for every SQL tool, in milliseconds.
AGENT_SQL_STATEMENT_TIMEOUT_MS=15000
